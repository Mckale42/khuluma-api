# ---- Khuluma API environment ----
# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).

# Server
PORT=8080

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khuluma?retryWrites=true&w=majority

# Firebase Admin — service account for verifying ID tokens.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on ONE line (escaped), OR set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT=

# Google Gemini (AI Studio > Get API key). Stays server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to bypass Firebase token checks during local dev / testing ONLY.
AUTH_DEV_BYPASS=false

# Hourly streak-reminder push notifications (FCM). Leave false for local/demo runs.
REMINDERS_ENABLED=false

# Firebase Storage bucket holding the native-speaker audio clips (private; the API hands out signed URLs).
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Blob storage for the native-speaker audio clips (private; the API hands out 15-minute signed URLs).
# Option A — Azure Blob Storage (free with Azure for Students): storage account name + access key.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=khuluma
# Option B — Firebase Storage (set FIREBASE_STORAGE_BUCKET above; needs the Blaze plan).
