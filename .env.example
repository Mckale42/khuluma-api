# ---- Khuluma API environment ----
# Copy to ".env" and fill in. NEVER commit the real .env (it is gitignored).

# Server
PORT=8080

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khuluma?retryWrites=true&w=majority

# Firebase Admin — service account for verifying ID tokens.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on ONE line (escaped), OR set GOOGLE_APPLICATION_CREDENTIALS to a file path.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT=

# Google Gemini (AI Studio > Get API key). Stays server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to "true" to bypass Firebase token checks during local dev / testing ONLY.
AUTH_DEV_BYPASS=false
