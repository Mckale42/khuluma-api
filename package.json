{
  "name": "khuluma-api",
  "version": "1.0.0",
  "description": "Khuluma REST API \u2014 gamified South African language learning (PROG7314 POE Part 2, The Viltrumites).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
